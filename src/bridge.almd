// wasm エントリ — ブラウザの raf から呼ぶ。
//
// JS はジェスチャ開始時刻を持ち、毎フレーム u = (now-startT)/duration を計算して
// 8 channel ぶん gesture_ch(gid, ch, u) を呼び、返ったオフセットを idle clip に
// 加算合成して VRM ボーンに適用する(適用 = Three.js の I/O は JS が担当)。
//
// gid / ch は Float で受ける(wasm の Int=i64 → JS BigInt を避けるため。値は小さい
// 整数なので Float で安全)。内部で float.to_int に丸める。
//
// codegen の tree-shaking 対策で main から全 export を参照してルート化(almide#440)。
//
// ビルド: almide build src/bridge.almd --target wasm -o build/gesture.wasm

import self as gp
import float

// ジェスチャ g の進捗 u における channel ch のボーンオフセット。
@export(wasm, "gesture_ch")
fn gesture_ch(gid: Float, ch: Float, u: Float) -> Float =
  gp.channel(float.to_int(gid), float.to_int(ch), u)

// ジェスチャ g の持続時間 (秒)。JS が u の正規化に使う。
@export(wasm, "gesture_duration")
fn gesture_duration(gid: Float) -> Float = gp.duration(float.to_int(gid))

effect fn main() -> Unit = {
  let _a = gesture_ch(0.0, 0.0, 0.0)
  let _b = gesture_duration(0.0)
  ()
}
